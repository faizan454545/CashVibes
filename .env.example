APP_NAME=CashVibes
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=cashvibes
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app-name.onrender.com/auth/google/callback

# CashVibes System Constants
COIN_VALUE_PKR=0.30
REGISTRATION_BONUS=50
REFERRAL_BONUS_AMT=50
MIN_WITHDRAWAL_COINS=500
REFERRAL_TASK_REWARD_PCT=0.10

# CPX Research Offerwall
CPX_APP_ID=your-cpx-app-id
CPX_SECURE_HASH=your-cpx-secure-hash
CPX_WHITELIST_IPS=188.40.3.73,157.90.97.92

# TimeWall Offerwall
TIMEWALL_PLACEMENT_ID=your-timewall-placement-id
TIMEWALL_SECRET_KEY=your-timewall-secret-key
TIMEWALL_WHITELIST_IPS=18.156.132.55,51.81.120.73,142.111.248.18

# BitLabs Offerwall
BITLABS_APP_TOKEN=your-bitlabs-app-token
BITLABS_SECRET_KEY=your-bitlabs-secret-key
BITLABS_SERVER_KEY=your-bitlabs-server-key

# reCAPTCHA v2
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Session & Security
SESSION_DOMAIN=your-app-name.onrender.com
